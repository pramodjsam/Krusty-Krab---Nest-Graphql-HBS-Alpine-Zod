<section id='forgotPassword'>
	<div class='container mt-5'>
		<div class='row'>
			<div class='col'>
				<div class='w-75 mx-auto backlink'>
					<a class='text-decoration-none backlink'>
						<i class='bi bi-arrow-left fs-2 me-2'></i>
						<span>Go Back</span>
					</a>
				</div>

				{{!-- Register email for forgot password --}}
				<div class='mt-5'>
					<h2 class='text-center mb-5'>Forgot Password</h2>
					<form class='w-75 mx-auto mb-3 mt-5'>
						<div class='mb-3'>
							<label class='form-label text-black'>Enter registered email address</label>
							<input
								class='border-secondary form-control'
								type='email'
								placeholder='Enter email'
								name='email'
							/>
						</div>
						<div class='d-grid mb-3'>
							<button class='btn btn-block mt-3 btn-danger' type='submit'>Submit</button>
						</div>
					</form>
				</div>

				{{!-- Validation code for forgot password --}}
				<div class='mt-5'>
					<div class='text-center mb-5'>
						<h3>Enter Validation Code</h3>
						<p>Enter validation code you have received via email</p>
					</div>
					<form class='w-75 mx-auto my-3'>
						<div class='mb-3'>
							<label class='text-black'>Validation Code</label>
							<input
								class='border-secondary form-control'
								type='text'
								placeholder='Enter code'
								name='code'
							/>
						</div>

						<div class='d-grid mb-3'>
							<button class='btn btn-block mt-3 btn-danger' type='submit'>Submit</button>
						</div>
					</form>
				</div>

				{{!-- Reset password for forget password --}}
				<div class='mt-5'>
					<div class='text-center mb-5'>
						<h3>Reset Password</h3>
					</div>
					<form class='w-75 mx-auto my-3'>
						<div class='mb-3'>
							<label class='text-black'>Password</label>
							<input
								class='form-control border-secondary'
								type='password'
								placeholder='Password'
								name='password'
							/>
						</div>
						<div class='mb-3'>
							<label class='text-black'>Confirm Password</label>
							<input
								class='form-control border-secondary'
								type='password'
								placeholder='Confirm Password'
								name='confirmPassword'
							/>
						</div>
						<div class='d-grid mb-3'>
							<button class='btn btn-block mt-3 btn-danger'>Reset Password</button>
						</div>
					</form>
				</div>

			</div>
		</div>
	</div>
</section>
