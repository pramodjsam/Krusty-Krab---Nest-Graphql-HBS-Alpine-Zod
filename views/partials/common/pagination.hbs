<div class="d-flex flex-col align-items-center justify-content-center">
	<nav aria-label="Page navigation">
		<ul class="pagination">
			<li class="page-item" :class="{ 'disabled': currentPage === 1 }">
				<button class="page-link text-black" @click="{{handlePageClick}}(currentPage - 1)">Previous</button>
			</li>
			<template x-for="page in visiblePages()" :key="page.key">
				<li class="page-item" :class="{ 'active': page.number === currentPage, 'disabled': page.isEllipsis }">
					<button
						class="page-link"
						x-text="page.text"
						:class="{ 'disabled': currentPage === page.number }"
						@click="!page.isEllipsis && {{handlePageClick}}(page.number)"
					></button>
				</li>
			</template>
			<li class="page-item" :class="{ 'disabled': currentPage === totalPages }">
				<button class="page-link text-black" @click="{{handlePageClick}}(currentPage + 1)">Next</button>
			</li>
		</ul>
	</nav>
</div>
