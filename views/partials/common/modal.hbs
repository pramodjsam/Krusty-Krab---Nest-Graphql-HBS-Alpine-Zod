<div id="{{id}}" class="modal" tabindex="-1" aria-labelledby="{{id}}Label" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">{{title}}</h5>
				<button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<p>{{message}}</p>
			</div>

			<div class="modal-footer">
				<button class="btn btn-secondary" type="button" data-bs-dismiss="modal">{{cancelText}}</button>

				<button class="btn btn-danger" type="button" @click="{{confirmAction}}">{{confirmText}}</button>
			</div>
		</div>
	</div>
</div>
