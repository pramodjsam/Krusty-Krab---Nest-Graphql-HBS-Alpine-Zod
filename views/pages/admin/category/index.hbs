<section id="adminCategory" class="p-3" x-data="categoryAdminPage()">
	{{> common/loader state="loading"}}
	<div class="info d-flex align-items-center justify-content-between">
		<h1>Categories</h1>
		<a href="/user/admin/category/add"><button class="btn btn-primary btn-sm py-2">Add New Category</button></a>
	</div>
	{{> common/search showReset=true resetText="Clear" handleReset="clearSearch" submitText="Search"
	placeholder="Search..." model="searchText" onSubmit="handleSearchSubmit" }}
	<table class="table striped">
		<colgroup>
			<col style="width: 10%" />
			<col style="width: 60%" />
			<col style="width: 10%" />
			<col style="width: 20%" />
		</colgroup>
		<thead>
			<tr>
				<th>
					<a href="#" class="text-black text-underline" @click.prevent="sort('id')"
						>#
						<span x-text="sortBy === 'id' ? (sortOrder === 'ASC' ? '↑' : '↓') : ''"></span>
					</a>
				</th>
				<th>
					<a href="#" class="text-black text-underline" @click.prevent="sort('name')"
						>Name
						<span x-text="sortBy === 'name' ? (sortOrder === 'ASC' ? '↑' : '↓') : ''"></span>
					</a>
				</th>
				<th>Image</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			<template class="admin-list" x-for="category in categories" :key="category.id">
				<tr class="admin-list__row">
					<td class="align-middle" x-text="category.id"></td>
					<td class="align-middle" x-text="category.name"></td>
					<td>
						<img :src="category.image?.url || '/images/burger.png'" class="admin-category-list__logo" />
					</td>
					<td class="align-middle">
						<a class="btn btn-warning btn-sm text-black" :href="`/user/admin/category/edit/${category.id}`">
							Edit
						</a>
						<button
							class="btn btn-danger btn-sm"
							data-bs-toggle="modal"
							data-bs-target="#deleteModal"
							@click="openDeleteModal(category.id)"
						>
							Delete
						</button>
					</td>
				</tr>
			</template>
		</tbody>
	</table>
	{{> common/pagination currentPage=currentPage totalPages=totalPages visiblePages=visiblePages
	handlePageClick="goToPage" }} {{> common/modal id="deleteModal" title="Warning" message="Are you sure you want to
	delete?" cancelText="Close" confirmText="Yes" confirmAction="confirmDelete()" }}
</section>
