<section id='register'>
	<div class='container mt-5'>
		<div class='row'>
			<div class='col'>
				<h2 class='text-center'>Register</h2>
				<form class='w-75 mx-auto mt-4'>
					<div class='row'>
						<div class='col col-md-6'>
							<div class='mb-3'>
								<label class='form-label text-black'>Name</label>
								<input
									class='form-control border-secondary'
									type='text'
									placeholder='Enter name'
									name='name'
								/>
							</div>
						</div>

						<div class='col col-md-6'>
							<div class='mb-3'>
								<label class='form-label text-black'>Email Address</label>
								<input
									class='form-control border-secondary'
									type='email'
									placeholder='Enter email'
									name='email'
								/>
							</div>
						</div>

						<div class='col col-md-6'>
							<div class='mb-3'>
								<label class='form-label text-black'>Phone</label>
								<input
									class='form-control border-secondary'
									type='text'
									placeholder='Enter phone'
									name='phone'
								/>
							</div>
						</div>

						<div class='col col-md-6'>
							<div class='mb-3'>
								<label class='form-label text-black'>Address</label>
								<input
									class='form-control border-secondary'
									type='text'
									placeholder='Enter address'
									name='address'
								/>
							</div>
						</div>

						<div class='col col-md-6'>
							<div class='mb-3'>
								<label class='form-label text-black'>City</label>
								<input
									class='form-control border-secondary'
									type='text'
									placeholder='Enter city'
									name='city'
								/>
							</div>
						</div>

						<div class='col col-md-6'>
							<div class='mb-3'>
								<label class='form-label text-black'>Province</label>
								<input
									class='form-control border-secondary'
									type='text'
									placeholder='Enter province'
									name='province'
								/>
							</div>
						</div>

						<div class='col-12'>
							<div class='mb-3'>
								<label class='form-label text-black'>Zip Code</label>
								<input
									class='form-control border-secondary'
									type='text'
									placeholder='Enter zip code'
									name='zipcode'
								/>
							</div>
						</div>

						<div class='col col-md-6'>
							<div class='mb-3'>
								<label class='form-label text-black'>Password</label>
								<input
									class='form-control border-secondary'
									type='password'
									placeholder='Enter password'
									name='password'
								/>
							</div>
						</div>

						<div class='col col-md-6'>
							<div class='mb-3'>
								<label class='form-label text-black'>Confirm Password</label>
								<input
									class='form-control border-secondary'
									type='password'
									placeholder='Enter confirmPassword'
									name='confirmPassword'
								/>
							</div>
						</div>
					</div>

					<div class='d-grid mb-3'>
						<button class='btn btn-block mt-3 btn-danger' type='submit'>Register</button>
					</div>
					<div class='form-text text-muted'>
						Already have an account?
						<a href='/auth/login'>Sign In</a>
					</div>
				</form>
			</div>
		</div>
	</div>
</section>
