<section id="adminCategory" class="p-3" x-data="categoryAdminPage()">
	{{> common/loader state="loading"}}
	<div class="info d-flex align-items-center justify-content-between">
		<h1>Categories</h1>
		<a href="/user/admin/category/add"><button class="btn btn-primary btn-sm py-2">Add New Category</button></a>
	</div>
	<form class="my-3" @submit.prevent="handleSearchSubmit">
		<div class="row">
			<div class="col-md-6">
				<div class="input-group">
					<input type="text" class="form-control shadow-none" x-model="searchText" />
					<button type="submit" class="btn btn-secondary">Search</button>
					<button type="button" class="btn btn-success" @click="clearSearch">Reset</button>
				</div>
			</div>
		</div>
	</form>
	<table class="table striped">
		<colgroup>
			<col style="width: 10%" />
			<col style="width: 60%" />
			<col style="width: 10%" />
			<col style="width: 20%" />
		</colgroup>
		<thead>
			<tr>
				<th>
					<a href="#" class="text-black text-underline" @click.prevent="sort('id')"
						>#
						<span x-text="sortBy === 'id' ? (sortOrder === 'ASC' ? '↑' : '↓') : ''"></span>
					</a>
				</th>
				<th>
					<a href="#" class="text-black text-underline" @click.prevent="sort('name')"
						>Name
						<span x-text="sortBy === 'name' ? (sortOrder === 'ASC' ? '↑' : '↓') : ''"></span>
					</a>
				</th>
				<th>Image</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			<template class="admin-list" x-for="category in categories" :key="category.id">
				<tr class="admin-list__row">
					<td class="align-middle" x-text="category.id"></td>
					<td class="align-middle" x-text="category.name"></td>
					<td>
						<img :src="category.image?.url || '/images/burger.png'" class="admin-category-list__logo" />
					</td>
					<td class="align-middle">
						<a class="btn btn-warning btn-sm text-black" :href="`/user/admin/category/edit/${category.id}`">
							Edit
						</a>
						<button
							class="btn btn-danger btn-sm"
							data-bs-toggle="modal"
							data-bs-target="#deleteModal"
							@click="openDeleteModal(category.id)"
						>
							Delete
						</button>
					</td>
				</tr>
			</template>
		</tbody>
	</table>
	<div class="d-flex flex-col align-items-center justify-content-center">
		<nav aria-label="Page navigation example">
			<ul class="pagination">
				<li class="page-item" :class="{ 'disabled': currentPage === 1 }">
					<button class="page-link text-black" @click="goToPage(currentPage - 1)">Previous</button>
				</li>
				<template x-for="page in visiblePages()" :key="page.key">
					<li
						class="page-item"
						:class="{ 'active': page.number === currentPage, 'disabled': page.isEllipsis }"
					>
						<button
							class="page-link"
							x-text="page.text"
							:class="{ 'disabled': currentPage === page.number }"
							@click="!page.isEllipsis && goToPage(page.number)"
						></button>
					</li>
				</template>
				<li class="page-item" :class="{ 'disabled': currentPage === totalPages }">
					<button class="page-link text-black" @click="goToPage(currentPage + 1)">Next</button>
				</li>
			</ul>
		</nav>
	</div>

	{{> common/modal id="deleteModal" title="Warning" message="Are you sure you want to delete?" cancelText="Close"
	confirmText="Yes" confirmAction="confirmDelete()" }}
</section>
