<section id="profile" x-data="profilePage()">
	{{> common/loader state="loading"}}
	<div class="container mt-5">
		<div class="row">
			<div class="col">
				<h2 class="text-center">Your Profile</h2>
				<form class="w-75 mx-auto mt-4" @submit.prevent="updateUser">
					<div class="row">
						<div class="col col-md-6">
							<div class="mb-3">
								<label class="text-black">Name</label>
								<input
									class="form-control border-secondary"
									type="text"
									placeholder="Enter Name"
									name="name"
									x-model="form.name"
								/>
							</div>
						</div>

						<div class="col col-md-6">
							<div class="mb-3">
								<label class="text-black">Email Address</label>
								<input
									class="form-control border-secondary"
									disabled
									type="email"
									placeholder="Enter Email"
									name="email"
									x-model="form.email"
								/>
							</div>
						</div>

						<div class="col col-md-6">
							<div class="mb-3">
								<label class="text-black">Address</label>
								<input
									class="form-control border-secondary"
									type="text"
									placeholder="Enter address"
									name="address"
									x-model="form.address"
								/>
							</div>
						</div>

						<div class="col col-md-6">
							<div class="mb-3">
								<label class="text-black">City</label>
								<input
									class="form-control border-secondary"
									type="text"
									placeholder="Enter city"
									name="city"
									x-model="form.city"
								/>
							</div>
						</div>

						<div class="col col-md-6">
							<div class="mb-3">
								<label class="text-black">Province</label>
								<input
									class="form-control border-secondary"
									type="text"
									placeholder="Enter province"
									name="province"
									x-model="form.province"
								/>
							</div>
						</div>

						<div class="col col-md-6">
							<div class="mb-3">
								<label class="text-black">Enter Zipcode</label>
								<input
									class="form-control border-secondary"
									type="text"
									placeholder="Enter Zipcode"
									name="zipCode"
									x-model="form.zipCode"
								/>
							</div>
						</div>
					</div>

					<div class="d-grid mb-3">
						<button class="btn btn-block mt-3 btn-warning" type="submit">Update</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</section>
