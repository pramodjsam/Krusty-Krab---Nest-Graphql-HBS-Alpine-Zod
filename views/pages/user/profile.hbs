<section id='profile'>
	<div class='container mt-5'>
		<div class='row'>
			<div class='col'>
				<h2 class='text-center'>Your Profile</h2>
				<form class='w-75 mx-auto mt-4'>
					<div class='row'>

						<div class='col col-md-6'>
							<div class='mb-3'>
								<label class='text-black'>Name</label>
								<input class='form-control border-secondary' type='text' placeholder='Enter Name' />
							</div>
						</div>

						<div class='col col-md-6'>
							<div class='mb-3'>
								<label class='text-black'>Email Address</label>
								<input class='form-control border-secondary' type='email' placeholder='Enter Email' />
							</div>
						</div>

						<div class='col col-md-6'>
							<div class='mb-3'>
								<label class='text-black'>Address</label>
								<input class='form-control border-secondary' type='text' placeholder='Enter address' />
							</div>
						</div>

						<div class='col col-md-6'>
							<div class='mb-3'>
								<label class='text-black'>City</label>
								<input class='form-control border-secondary' type='text' placeholder='Enter city' />
							</div>
						</div>

						<div class='col col-md-6'>
							<div class='mb-3'>
								<label class='text-black'>Province</label>
								<select class='form-control border-secondary' name='province'>
									<option value=''>Select Province</option>
									<option value='ontario'>Ontario</option>
									<option value='british columbia'>British Columbia</option>
								</select>
							</div>
						</div>

						<div class='col col-md-6'>
							<div class='mb-3'>
								<label class='text-black'>Enter Zipcode</label>
								<input class='form-control border-secondary' type='text' placeholder='Enter Zipcode' />
							</div>
						</div>

					</div>

					<div class='d-grid mb-3'>
						<button class='btn btn-block mt-3 btn-warning' type='submit'>Update</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</section>
