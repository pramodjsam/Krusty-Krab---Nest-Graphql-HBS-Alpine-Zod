<section id="adminUser" class="p-3" x-data="userAdminPage()">
	{{> common/loader state="loading"}}
	<div class="info">
		<h1>Users</h1>
	</div>
	{{> common/search showReset=true resetText="Clear" handleReset="clearSearch" submitText="Search"
	placeholder="Search..." model="searchText" onSubmit="handleSearchSubmit" }}
	<table class="table striped mt-5">
		<colgroup>
			<col style="width: 10%" />
			<col style="width: 30%" />
			<col style="width: 20%" />
			<col style="width: 10%" />
			<col style="width: 20%" />
			<col style="width: 10%" />
		</colgroup>
		<thead>
			<tr>
				<th>
					<a href="#" class="text-black text-underline" @click.prevent="sort('id')"
						>#
						<span x-text="sortBy === 'id' ? (sortOrder === 'ASC' ? '↑' : '↓') : ''"></span>
					</a>
				</th>
				<th>
					<a href="#" class="text-black text-underline" @click.prevent="sort('name')"
						>Name
						<span x-text="sortBy === 'name' ? (sortOrder === 'ASC' ? '↑' : '↓') : ''"></span>
					</a>
				</th>
				<th>Email</th>
				<th>Role</th>
				<th>Created At</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			<template class="admin-list" x-for="user in users" :key="user.id">
				<tr>
					<td class="align-middle" x-text="user.id">1</td>
					<td class="align-middle" x-text="user.name">John Doe</td>
					<td class="align-middle" x-text="user.email">john@email.com</td>
					<td class="align-middle">
						<select x-model="user.role" class="form-select" :disabled="form.id !== user.id">
							{{#each role}}
							<option value="{{this}}">{{this}}</option>
							{{/each}}
						</select>
					</td>
					<td class="align-middle" x-text="user.createdAt">14 May 2026 15:30 EDT</td>
					<td class="align-middle">
						<button
							class="btn btn-warning btn-sm text-black"
							x-show="form.id !== user.id"
							@click="startEdit(user)"
						>
							Edit
						</button>
						<button class="btn btn-success btn-sm" x-show="form.id === user.id" @click="saveEdit()">
							Save
						</button>
						{{!--
						<button
							disabled
							class="btn btn-danger btn-sm"
							data-bs-toggle="modal"
							data-bs-target="#deleteModal"
						>
							Delete
						</button>
						--}}
					</td>
				</tr>
			</template>
			<template x-if="users.length === 0">
				<tr>
					<td colspan="6" class="text-center text-muted py-3">No User Found</td>
				</tr>
			</template>
		</tbody>
	</table>
	{{> common/pagination currentPage=currentPage totalPages=totalPages visiblePages=visiblePages
	handlePageClick="goToPage" }} {{!-- {{> common/modal id="deleteModal" title="Warning" message="Are you sure you want
	to delete?" cancelText="Close" confirmText="Yes" confirmAction="confirmDelete()" }} --}}
</section>
