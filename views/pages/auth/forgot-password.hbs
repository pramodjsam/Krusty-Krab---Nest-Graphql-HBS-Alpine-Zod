<section id="forgotPassword" x-data="forgotPassword()">
	{{> common/loader state="loading"}}
	<div class="container mt-5">
		<div class="row">
			<div class="col">
				<div class="w-75 mx-auto backlink">
					<a class="text-decoration-none backlink" href="#" @click.prevent="goToPreviousStep()">
						<i class="bi bi-arrow-left fs-2 me-2"></i>
						<span>Go Back</span>
					</a>
				</div>

				{{!-- Register email for forgot password --}}
				<template x-if="activeStep === 1">
					<div class="mt-5">
						<h2 class="text-center mb-5">Forgot Password</h2>
						<form class="w-75 mx-auto mb-3 mt-5" @submit.prevent="sendResetToken()">
							<div class="mb-3">
								<label class="form-label" :class="errors['email'] ? 'text-danger' : 'text-black'"
									>Enter registered email address</label
								>
								<input
									class="border-secondary form-control"
									:class=" {'border border-danger': errors['email']}"
									type="email"
									placeholder="Enter email"
									name="email"
									x-model="form1Info.email"
								/>
							</div>
							<div class="d-grid mb-3">
								<button class="btn btn-block mt-3 btn-danger" type="submit">Submit</button>
							</div>
						</form>
					</div>
				</template>

				{{!-- Validation code for forgot password --}}
				<template x-if="activeStep === 2">
					<div class="mt-5">
						<div class="text-center mb-5">
							<h3>Enter Validation Code</h3>
							<p>Enter validation code you have received via email</p>
						</div>
						<form class="w-75 mx-auto my-3" @submit.prevent="confirmResetToken()">
							<div class="mb-3">
								<label class="form-label" :class="errors['code'] ? 'text-danger' : 'text-black'"
									>Validation Code</label
								>
								<input
									class="border-secondary form-control"
									:class=" {'border border-danger': errors['code']}"
									maxlength="4"
									minlength="4"
									type="text"
									inputmode="numeric"
									placeholder="Enter code"
									name="code"
									x-model="form2Info.code"
									@input="form2Info.code = form2Info.code.replace(/\D/g, '').slice(0, 4)"
								/>
							</div>

							<div class="d-grid mb-3">
								<button class="btn btn-block mt-3 btn-danger" type="submit">Submit</button>
							</div>
						</form>
					</div>
				</template>

				{{!-- Reset password for forget password --}}
				<template x-if="activeStep === 3">
					<div class="mt-5">
						<div class="text-center mb-5">
							<h3>Reset Password</h3>
						</div>
						<form class="w-75 mx-auto my-3" @submit.prevent="resetPassword()">
							<div class="mb-3">
								<label class="form-label" :class="errors['password'] ? 'text-danger' : 'text-black'"
									>Password</label
								>
								<input
									class="form-control border-secondary"
									:class=" {'border border-danger': errors['password']}"
									type="password"
									placeholder="Password"
									name="password"
									x-model="form3Info.password"
								/>
							</div>
							<div class="mb-3">
								<label
									class="form-label"
									:class="errors['confirmPassword'] ? 'text-danger' : 'text-black'"
									>Confirm Password</label
								>
								<input
									class="form-control border-secondary"
									:class=" {'border border-danger': errors['confirmPassword']}"
									type="password"
									placeholder="Confirm Password"
									name="confirmPassword"
									x-model="form3Info.confirmPassword"
								/>
							</div>
							<div class="d-grid mb-3">
								<button class="btn btn-block mt-3 btn-danger">Reset Password</button>
							</div>
						</form>
					</div>
				</template>
			</div>
		</div>
	</div>
</section>
