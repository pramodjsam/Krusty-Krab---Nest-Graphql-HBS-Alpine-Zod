<section id="adminProduct" class="p-3" x-data="productAdminPage()">
	{{> common/loader state="loading"}}
	<div class="info d-flex align-items-center justify-content-between">
		<h1>Products</h1>
		<a href="/user/admin/product/add"><button class="btn btn-primary btn-sm py-2">Add New Product</button></a>
	</div>
	{{> common/search showReset=true resetText="Clear" handleReset="clearSearch" submitText="Search"
	placeholder="Search..." model="searchText" onSubmit="handleSearchSubmit" }}
	<table class="table striped mt-5">
		<colgroup>
			<col style="width: 10%" />
			<col style="width: 40%" />
			<col style="width: 10%" />
			<col style="width: 20%" />
			<col style="width: 10%" />
			<col style="width: 10%" />
		</colgroup>
		<thead>
			<tr>
				<th>
					<a href="#" class="text-black text-underline" @click.prevent="sort('id')"
						>#
						<span x-text="sortBy === 'id' ? (sortOrder === 'ASC' ? '↑' : '↓') : ''"></span>
					</a>
				</th>
				<th>
					<a href="#" class="text-black text-underline" @click.prevent="sort('name')"
						>Name
						<span x-text="sortBy === 'name' ? (sortOrder === 'ASC' ? '↑' : '↓') : ''"></span>
					</a>
				</th>
				<th>
					<a href="#" class="text-black text-underline" @click.prevent="sort('price')"
						>Price
						<span x-text="sortBy === 'price' ? (sortOrder === 'ASC' ? '↑' : '↓') : ''"></span>
					</a>
				</th>
				<th>Category</th>
				<th>Image</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			<template class="admin-list" x-for="product in products" :key="product.id">
				<tr class="admin-list__row">
					<td class="align-middle" x-text="product.id"></td>
					<td class="align-middle" x-text="product.name"></td>
					<td class="align-middle" x-text="`$${product.price}`"></td>
					<td class="align-middle" x-text="product.category.name"></td>
					<td>
						<img class="admin-category-list__logo" :src="product.image?.url || '/images/burger.png'" />
					</td>
					<td class="align-middle">
						<a class="btn btn-warning btn-sm text-black" :href="`/user/admin/product/edit/${product.id}`"
							>Edit</a
						>
						<button
							class="btn btn-danger btn-sm"
							data-bs-toggle="modal"
							data-bs-target="#deleteModal"
							@click="openDeleteModal(product.id)"
						>
							Delete
						</button>
					</td>
				</tr>
			</template>
			<template x-if="products.length === 0">
				<tr>
					<td colspan="6" class="text-center text-muted py-3">No Product Found</td>
				</tr>
			</template>
		</tbody>
	</table>

	{{> common/pagination currentPage=currentPage totalPages=totalPages visiblePages=visiblePages
	handlePageClick="goToPage" }} {{> common/modal id="deleteModal" title="Warning" message="Are you sure you want to
	delete?" cancelText="Close" confirmText="Yes" confirmAction="confirmDelete()" }}
</section>
